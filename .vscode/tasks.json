{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "${fileDirname}/SLList.cpp",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Build Ashen Crown",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-O2",
                "${workspaceFolder}/ashlands/ashen_crown.cpp",
                "-o",
                "${workspaceFolder}/ashlands/ashen_crown"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Build the Ashen Crown game so it can be launched in the terminal."
        },
        {
            "label": "Run Ashen Crown",
            "type": "shell",
            "command": "${workspaceFolder}/ashlands/ashen_crown",
            "options": {
                "cwd": "${workspaceFolder}/ashlands"
            },
            "dependsOn": [
                "Build Ashen Crown"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Launch the game in the integrated terminal so its menu and prompts are visible."
        },
        {
            "label": "Build SLList tail",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "${workspaceFolder}/other/03_SLList_tail/SLList_main.cpp",
                "${workspaceFolder}/other/03_SLList_tail/SLList.cpp",
                "-o",
                "${workspaceFolder}/other/03_SLList_tail/SLList_main"
            ],
            "options": {
                "cwd": "${workspaceFolder}/other/03_SLList_tail"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Build the tail-linked singly linked list example."
        },
        {
            "label": "Run SLList tail",
            "type": "shell",
            "command": "${workspaceFolder}/other/03_SLList_tail/SLList_main",
            "options": {
                "cwd": "${workspaceFolder}/other/03_SLList_tail"
            },
            "dependsOn": [
                "Build SLList tail"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Run the tail-linked singly linked list example in the terminal."
        }
    ],
    "version": "2.0.0"
}